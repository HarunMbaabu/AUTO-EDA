# Copy to .env and fill in. Never commit .env.

# Required for Phase 1. Get the token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use private features.
# Send /myid to the bot to find yours. Empty = everyone is denied.
TELEGRAM_ALLOWED_USER_IDS=

LOG_LEVEL=INFO

# AI analysis (/analyze). Provider: AI_PROVIDER (mistral | deepseek | anthropic), or else the
# first key that is set: Mistral, then DeepSeek, then Claude (ANTHROPIC_API_KEY + CLAUDE_MODEL).
# Check with: uv run brains-bot-check-ai  (lists the models your key can use)
AI_PROVIDER=
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-14b-latest
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# Claude (alternative provider). The bot uses only this key and the official API address;
# inherited ANTHROPIC_BASE_URL or CLI logins are ignored. BOT_ANTHROPIC_BASE_URL overrides it.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Phase 2 onwards. PostgreSQL connection, e.g.
# DATABASE_URL=postgresql://brains:change-me@localhost:5432/brains_bot
DATABASE_URL=
