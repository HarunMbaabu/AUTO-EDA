# Copy to .env and fill in. Never commit .env.

# Required for Phase 1. Get the token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to use private features.
# Send /myid to the bot to find yours. Empty = everyone is denied.
TELEGRAM_ALLOWED_USER_IDS=

LOG_LEVEL=INFO

# Optional until Phase 3. Used only by the connectivity check for now.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Phase 2 onwards.
DATABASE_URL=
